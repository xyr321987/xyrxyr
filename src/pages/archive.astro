---
import Layout from "../layouts/Layout.astro";
---

<Layout uid="archive">
  <div class="content resume-archive">
    <h1
      class="title"
      data-motion-text="true"
      data-motion-text-split="chars"
      data-motion-text-duration="0.5"
    >
      个人兴趣
    </h1>

    <div class="interests-grid">
      <div class="interest-card">
        <div class="interest-icon"><i class="fas fa-running"></i></div>
        <h3>跑步</h3>
        <p>保持长期运动习惯，培养自律性与持续执行能力</p>
      </div>

      <div class="interest-card">
        <div class="interest-icon"><i class="fas fa-book-open"></i></div>
        <h3>小说</h3>
        <p>喜欢阅读小说，关注故事结构、人物塑造及不同类型作品</p>
      </div>

      <div class="interest-card">
        <div class="interest-icon"><i class="fas fa-yin-yang"></i></div>
        <h3>太极</h3>
        <p>练习太极，注重专注力、耐心与身体协调性</p>
      </div>
    </div>

    <!-- 个人优势 -->
    <div class="section-card advantages">
      <div class="section-header">
        <i class="fas fa-star"></i>
        <h2>个人优势</h2>
      </div>
      <div class="advantages-list">
        <div class="advantage-item">
          <div class="advantage-icon"><i class="fas fa-microchip"></i></div>
          <div class="advantage-body">
            <h4>AI 实践</h4>
            <p>将 AI 应用于编程、音乐、PPT、知识库及个人网站等多个实际项目</p>
          </div>
        </div>
        <div class="advantage-item">
          <div class="advantage-icon"><i class="fas fa-graduation-cap"></i></div>
          <div class="advantage-body">
            <h4>自主学习</h4>
            <p>通过项目实践快速学习新工具，具备较强的信息检索与问题解决能力</p>
          </div>
        </div>
        <div class="advantage-item">
          <div class="advantage-icon"><i class="fas fa-handshake"></i></div>
          <div class="advantage-body">
            <h4>实践能力</h4>
            <p>具备地推、门店服务及班级管理经历，拥有沟通、执行与团队协作经验</p>
          </div>
        </div>
        <div class="advantage-item">
          <div class="advantage-icon"><i class="fas fa-rocket"></i></div>
          <div class="advantage-body">
            <h4>发展方向</h4>
            <p>关注 AI、互联网及医疗健康交叉领域，持续积累项目实践经验</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // 3D 鼠标跟踪倾斜效果 - 兴趣卡片 & 优势条目
  (function initArchiveCards() {
    const cards = document.querySelectorAll('.interest-card, .advantage-item');
    cards.forEach((card) => {
      const onMove = (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotateX = ((y - centerY) / centerY) * -8;
        const rotateY = ((x - centerX) / centerX) * 8;
        card.style.transform = `perspective(600px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
        card.style.setProperty('--mx', ((x / rect.width) * 100) + '%');
        card.style.setProperty('--my', ((y / rect.height) * 100) + '%');
      };
      const onLeave = () => {
        card.style.transform = 'perspective(600px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
      };
      card.addEventListener('mousemove', onMove);
      card.addEventListener('mouseleave', onLeave);
    });
  })();
</script>