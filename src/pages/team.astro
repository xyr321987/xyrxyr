	<script>
	  (function initCertCarousel() {
	    const wrapper = document.querySelector('.cert-track-wrapper');
	    const track = document.querySelector('.cert-gallery');
	    if (!wrapper || !track) return;

	    const items = track.querySelectorAll('.cert-gallery-item');
	    if (items.length === 0) return;

	    let itemWidth = 0;
	    let gap = 14;
	    let visibleCount = 4;
	    let position = 0;          // 当前 translateX 偏移（负值）
	    let maxPosition = 0;       // 最大可滑动距离
	    let autoSpeed = 0.4;       // 自动滑动速度 (px/frame)
	    let isAutoPlaying = true;
	    let isHovering = false;
	    let isManualScrolling = false;
	    let manualTimeout = null;
	    let rafId = null;

	    function calcDimensions() {
	      const rect = items[0].getBoundingClientRect();
	      itemWidth = rect.width;
	      const wrapperRect = wrapper.getBoundingClientRect();
	      const style = getComputedStyle(track);
	      gap = parseInt(style.gap) || 14;
	      visibleCount = wrapperRect.width / (itemWidth + gap);
	      visibleCount = Math.floor(visibleCount) || 1;
	      const totalWidth = items.length * (itemWidth + gap);
	      maxPosition = totalWidth - wrapperRect.width;
	      if (maxPosition < 0) maxPosition = 0;
	    }

	    function updateTransform() {
	      track.style.transform = `translateX(${-position}px)`;
	    }

	    function autoSlide() {
	      if (!isAutoPlaying || isHovering || isManualScrolling) return;
	      position += autoSpeed;
	      if (position >= maxPosition) {
	        position = 0;
	      }
	      updateTransform();
	    }

	    function loop() {
	      autoSlide();
	      rafId = requestAnimationFrame(loop);
	    }

	    // 鼠标滚轮控制
	    wrapper.addEventListener('wheel', (e) => {
	      e.preventDefault();
	      isManualScrolling = true;
	      if (manualTimeout) clearTimeout(manualTimeout);

	      position += e.deltaY * 0.5;
	      if (position < 0) position = 0;
	      if (position > maxPosition) position = maxPosition;
	      updateTransform();

	      manualTimeout = setTimeout(() => {
	        isManualScrolling = false;
	      }, 2000);
	    }, { passive: false });

	    // 鼠标悬停暂停自动滑动
	    wrapper.addEventListener('mouseenter', () => {
	      isHovering = true;
	    });
	    wrapper.addEventListener('mouseleave', () => {
	      isHovering = false;
	    });

	    // 窗口尺寸变化重新计算
	    let resizeTimer = null;
	    window.addEventListener('resize', () => {
	      if (resizeTimer) clearTimeout(resizeTimer);
	      resizeTimer = setTimeout(() => {
	        calcDimensions();
	        if (position > maxPosition) {
	          position = maxPosition;
	          updateTransform();
	        }
	      }, 200);
	    });

	    calcDimensions();
	    loop();
	  })();
	</script>