	<script>
	  (function initCertCarousel() {
	    const wrapper = document.querySelector('.cert-track-wrapper');
	    const track = document.querySelector('.cert-gallery');
	    if (!wrapper || !track) return;

	    const items = track.querySelectorAll('.cert-gallery-item');
	    if (items.length === 0) return;

	    let gap = 14;
	    let position = 0;
	    let maxPosition = 0;
	    let autoSpeed = 0.4;
	    let isPaused = false;         // 悬停/拖拽/滚轮时暂停自动滑动
	    let resumeTimer = null;
	    let rafId = null;

	    // 拖拽相关（触摸 & 鼠标通用）
	    let isDragging = false;
	    let dragStartX = 0;
	    let dragStartPos = 0;

	    function calcDimensions() {
	      const wrapperRect = wrapper.getBoundingClientRect();
	      const style = getComputedStyle(track);
	      gap = parseInt(style.gap) || 14;
	      const itemWidth = items[0].getBoundingClientRect().width;
	      const totalWidth = items.length * (itemWidth + gap);
	      maxPosition = totalWidth - wrapperRect.width;
	      if (maxPosition < 0) maxPosition = 0;
	    }

	    function updateTransform() {
	      track.style.transform = `translateX(${-position}px)`;
	    }

	    function clamp(v) {
	      if (v < 0) return 0;
	      if (v > maxPosition) return maxPosition;
	      return v;
	    }

	    function autoSlide() {
	      if (isPaused) return;
	      position += autoSpeed;
	      if (position >= maxPosition) position = 0;
	      updateTransform();
	    }

	    function loop() {
	      autoSlide();
	      rafId = requestAnimationFrame(loop);
	    }

	    function pauseTemporarily(ms) {
	      isPaused = true;
	      if (resumeTimer) clearTimeout(resumeTimer);
	      resumeTimer = setTimeout(() => {
	        isPaused = false;
	      }, ms);
	    }

	    // 鼠标滚轮控制（桌面）
	    wrapper.addEventListener('wheel', (e) => {
	      e.preventDefault();
	      position = clamp(position + e.deltaY * 0.5);
	      updateTransform();
	      pauseTemporarily(2000);
	    }, { passive: false });

	    // —— 触摸 / 鼠标拖拽控制（手机手指滑动）——
	    wrapper.addEventListener('pointerdown', (e) => {
	      isDragging = true;
	      dragStartX = e.clientX;
	      dragStartPos = position;
	      isPaused = true;
	      if (resumeTimer) clearTimeout(resumeTimer);
	    });

	    window.addEventListener('pointermove', (e) => {
	      if (!isDragging) return;
	      const dx = e.clientX - dragStartX;
	      position = clamp(dragStartPos - dx);
	      updateTransform();
	    });

	    window.addEventListener('pointerup', () => {
	      if (!isDragging) return;
	      isDragging = false;
	      pauseTemporarily(2000);
	    });

	    window.addEventListener('pointercancel', () => {
	      isDragging = false;
	      pauseTemporarily(1500);
	    });

	    // 鼠标悬停暂停自动滑动（仅桌面有意义）
	    wrapper.addEventListener('mouseenter', () => {
	      if (window.matchMedia('(hover: hover)').matches) pauseTemporarily(3000);
	    });
	    wrapper.addEventListener('mouseleave', () => {
	      if (window.matchMedia('(hover: hover)').matches) pauseTemporarily(1000);
	    });

	    // 窗口尺寸变化重新计算
	    let resizeTimer = null;
	    window.addEventListener('resize', () => {
	      if (resizeTimer) clearTimeout(resizeTimer);
	      resizeTimer = setTimeout(() => {
	        calcDimensions();
	        if (position > maxPosition) {
	          position = maxPosition;
	          updateTransform();
	        }
	      }, 200);
	    });

	    calcDimensions();
	    loop();
	  })();
	</script>