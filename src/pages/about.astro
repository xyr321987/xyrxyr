---
import Layout from "../layouts/Layout.astro";
---

<Layout uid="about">
  <div class="content resume-about">
    <h1
      class="title"
      data-motion-text="true"
      data-motion-text-split="chars"
      data-motion-text-duration="0.5"
    >
      实践经历
    </h1>

    <div class="projects-grid">
      <!-- 新东方 · 中考地推 -->
      <article class="project-card" data-index="0">
        <div class="project-image">
          <span class="project-number">01</span>
          <img src="/实践1.jpg" alt="新东方中考地推" loading="lazy" />
        </div>
        <div class="project-content">
          <div class="project-meta">
            <span>新东方</span>
            <span>暑期实践</span>
          </div>
          <h3 class="project-title">中考地推</h3>
          <p class="project-description">
            参与新东方中考地推，负责线下宣传、用户沟通及推广执行。
            根据不同用户需求进行沟通，提升表达、沟通与现场应变能力。
            配合团队完成指定区域推广任务，培养团队协作与执行能力。
          </p>
          <div class="project-footer">
            <span class="project-link">了解更多 <span>→</span></span>
            <span class="pending" style="font-size:0.75rem;opacity:0.5">累计触达用户：待补充</span>
          </div>
        </div>
      </article>

      <!-- 美甲店 · 美甲师 -->
      <article class="project-card" data-index="1">
        <div class="project-image">
          <span class="project-number">02</span>
          <img src="/实践2.jpg" alt="美甲店美甲师" loading="lazy" />
        </div>
        <div class="project-content">
          <div class="project-meta">
            <span>美甲店</span>
            <span>暑期实践</span>
          </div>
          <h3 class="project-title">美甲师</h3>
          <p class="project-description">
            负责基础美甲服务及顾客沟通，熟悉门店服务流程。
            根据顾客需求完成款式沟通与服务，提高客户需求理解能力。
            独立完成日常工作任务，培养服务意识、执行力及时间管理能力。
          </p>
          <div class="project-footer">
            <span class="project-link">了解更多 <span>→</span></span>
            <span class="pending" style="font-size:0.75rem;opacity:0.5">累计服务顾客：待补充</span>
          </div>
        </div>
      </article>

      <!-- 班级班长 -->
      <article class="project-card" data-index="2">
        <div class="project-image">
          <span class="project-number">03</span>
          <img src="/实践3.jpg" alt="班级班长" loading="lazy" />
        </div>
        <div class="project-content">
          <div class="project-meta">
            <span>班级管理</span>
            <span>初一 & 高一</span>
          </div>
          <h3 class="project-title">班级班长</h3>
          <p class="project-description">
            两次担任班级班长，协助老师完成班级日常管理及事务协调。
            负责通知传达、活动组织及同学沟通，提升组织协调能力。
            协助推进班级集体事务，培养责任意识与团队协作能力。
          </p>
          <div class="project-footer">
            <span class="project-link">了解更多 <span>→</span></span>
          </div>
        </div>
      </article>
    </div>
  </div>
</Layout>