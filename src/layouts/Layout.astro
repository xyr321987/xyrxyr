---
import "../styles/app.css";
import Frame from "../components/frame.astro";
import Nav from "../components/nav.astro";
import TransitionSvgWrapper from "../components/TransitionSvgWrapper.astro";
import TransitionOverlay from "../components/TransitionOverlay.astro";
import TransitionMorphSvg from "../components/TransitionMorphSvg.astro";
const { uid } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>向宇然 · 个人简历</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>👤</text></svg>" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.1/css/all.min.css" />
  </head>
  <body data-barba="wrapper">
    <Frame />
    <div data-barba="container" data-barba-namespace={uid} class="app__wrapper">
      <main class="content__wrapper">
        <slot />
      </main>
    </div>
    <Nav />
    <TransitionSvgWrapper />
    <TransitionOverlay />
    <TransitionMorphSvg />
    <script src="../scripts/app.js"></script>
  </body>
</html>